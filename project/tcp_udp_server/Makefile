# ============================================================================
# 通用 Makefile - 自动编译 src/ 目录下的所有 C 文件
# ============================================================================
# 特点：
#   - 自动发现 src/ 目录下的所有 .c 文件
#   - 自动为每个 .c 文件生成对应的可执行文件
#   - 添加新的 .c 文件后无需修改 Makefile
# 
# 使用方法：
#   make              - 编译所有项目
#   make <程序名>     - 编译指定程序（例如：make tcp_echo_server）
#   make clean        - 清理编译生成的文件
#   make rebuild      - 重新编译项目
#   make run-<程序名> - 编译并运行指定程序（例如：make run-tcp_echo_server）
#   make list         - 列出所有可编译的程序
#   make help         - 显示帮助信息
# ============================================================================

# 编译器配置
CC = gcc
CFLAGS = -Wall -Wextra -g -O2

# 目录配置
SRC_DIR = src
BUILD_DIR = build

# 链接库（如果需要额外的库，在这里添加，例如 -lpthread -lm）
# 注意：pthread 库需要显式链接
LIBS = -lpthread

# ============================================================================
# 自动发现所有源文件
# ============================================================================
# 获取 src/ 目录下所有 .c 文件
SRCS = $(wildcard $(SRC_DIR)/*.c)

# 从源文件名生成目标文件名（去掉路径和扩展名）
# 例如：src/tcp_echo_server.c -> tcp_echo_server
TARGETS = $(patsubst $(SRC_DIR)/%.c,%,$(SRCS))

# 生成所有可执行文件路径
# 例如：tcp_echo_server -> build/tcp_echo_server
EXECUTABLES = $(patsubst %,$(BUILD_DIR)/%,$(TARGETS))

# 生成所有目标文件路径
# 例如：src/tcp_echo_server.c -> build/tcp_echo_server.o
OBJECTS = $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SRCS))

# 查找所有头文件（用于依赖检查）
HEADERS = $(wildcard $(SRC_DIR)/*.h)

# ============================================================================
# 默认目标：编译所有项目
# ============================================================================
all: $(BUILD_DIR) $(EXECUTABLES)
	@echo "=========================================="
	@echo "所有项目编译完成！"
	@echo "可执行文件："
	@for exe in $(EXECUTABLES); do \
		echo "  - $$exe"; \
	done
	@echo "=========================================="

# ============================================================================
# 创建编译输出目录
# ============================================================================
$(BUILD_DIR):
	@echo "创建编译输出目录: $(BUILD_DIR)"
	@mkdir -p $(BUILD_DIR)

# ============================================================================
# 模式规则：编译 .c 文件为 .o 文件
# ============================================================================
# 这个规则会自动应用到所有 .c 文件
# $< 表示第一个依赖（源文件）
# $@ 表示目标文件
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c $(HEADERS) | $(BUILD_DIR)
	@echo "编译: $< -> $@"
	$(CC) $(CFLAGS) -c $< -o $@

# ============================================================================
# 模式规则：链接 .o 文件为可执行文件
# ============================================================================
# 这个规则会自动应用到所有 .o 文件
$(BUILD_DIR)/%: $(BUILD_DIR)/%.o
	@echo "链接: $< -> $@"
	$(CC) $< -o $@ $(LIBS)
	@echo "编译完成: $@"

# ============================================================================
# 为每个目标创建单独的编译规则（可选，方便单独编译）
# ============================================================================
# 这会为每个程序创建独立的编译目标
# 例如：make tcp_echo_server 会只编译 tcp_echo_server
$(TARGETS): %: $(BUILD_DIR)/%

# ============================================================================
# 运行程序
# ============================================================================
# 使用模式规则创建 run-<程序名> 目标
# 例如：make run-tcp_echo_server
run-%: $(BUILD_DIR)/%
	@echo "运行程序: $<"
	./$<

# ============================================================================
# 列出所有可编译的程序
# ============================================================================
list:
	@echo "可编译的程序："
	@for target in $(TARGETS); do \
		echo "  - $$target"; \
	done
	@echo ""
	@echo "使用 'make <程序名>' 编译单个程序"
	@echo "使用 'make run-<程序名>' 运行程序"

# ============================================================================
# 清理编译生成的文件
# ============================================================================
clean:
	@echo "清理编译文件..."
	@rm -rf $(BUILD_DIR)
	@echo "清理完成！"

# ============================================================================
# 重新编译（先清理再编译）
# ============================================================================
rebuild: clean all

# ============================================================================
# 显示帮助信息
# ============================================================================
help:
	@echo "=========================================="
	@echo "通用 Makefile 使用说明"
	@echo "=========================================="
	@echo ""
	@echo "基本命令："
	@echo "  make              - 编译所有项目"
	@echo "  make <程序名>     - 编译指定程序"
	@echo "  make clean        - 清理编译文件"
	@echo "  make rebuild      - 重新编译项目"
	@echo "  make run-<程序名> - 编译并运行指定程序"
	@echo "  make list         - 列出所有可编译的程序"
	@echo "  make help         - 显示此帮助信息"
	@echo ""
	@echo "=========================================="

# ============================================================================
# 保留中间文件（.o 文件），不自动删除
# ============================================================================
.SECONDARY: $(OBJECTS)

# ============================================================================
# 声明伪目标（这些目标不对应实际文件）
# ============================================================================
.PHONY: all clean rebuild list help run-% $(TARGETS)
